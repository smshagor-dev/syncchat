{
  "name": "syncchat-desktop",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "icons": "tauri icon ../mobile/assets/syncchat_logo.png",
    "web:dev": "node scripts/dev-web.mjs",
    "web:build": "node scripts/build-web.mjs",
    "dev": "npm run icons && tauri dev",
    "build": "npm run icons && tauri build",
    "build:binary": "npm run icons && tauri build --no-bundle",
    "check": "npm run icons && cargo check --manifest-path src-tauri/Cargo.toml"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.11.4"
  }
}
