{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SyncChat",
  "version": "0.1.0",
  "identifier": "live.syncchat.desktop",
  "build": {
    "beforeDevCommand": "npm run web:dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run web:build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "SyncChat",
        "width": 1280,
        "height": 820,
        "minWidth": 940,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "maximizable": true,
        "minimizable": true,
        "closable": true,
        "fullscreen": false,
        "decorations": true,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self' customprotocol: asset:; connect-src 'self' ipc: http://ipc.localhost https: wss:; img-src 'self' asset: data: blob: https:; media-src 'self' asset: data: blob: https:; style-src 'self' 'unsafe-inline'; font-src 'self' data: https:; script-src 'self'; frame-src https:; object-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "category": "SocialNetworking",
    "shortDescription": "Secure real-time messaging with SyncChat.",
    "longDescription": "Native SyncChat desktop application with bundled web UI, realtime chat, calls, status, communities, channels, media and account controls.",
    "copyright": "Copyright (c) 2026 Md Shahanur Islam Shagor",
    "licenseFile": "../LICENSE",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["syncchat"]
      }
    }
  }
}
