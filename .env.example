NODE_ENV = development

# MySQL
DB_HOST = 127.0.0.1
DB_PORT = 3306
DB_NAME = syncchat
DB_USER = root
DB_PASSWORD = root
DB_AUTO_MIGRATE = true

# optional public origin for generated local upload URLs
# APP_ORIGIN = http://localhost:8080
# You can also provide multiple frontend origins, comma-separated.
# APP_ORIGIN = https://syncchat.live,https://www.syncchat.live
# Frontend runtime targets for production
# API_BASE_URL = https://syncchat.live/api
# SOCKET_URL = https://syncchat.live
# PUBLIC_ORIGIN = https://syncchat.live

# email transport (nodemailer)
# Gmail SMTP
SMTP_SERVICE = gmail
SMTP_HOST = smtp.gmail.com
SMTP_HOST_IP =
SMTP_SERVERNAME = smtp.gmail.com
SMTP_PORT = 465
SMTP_SECURE = true
SMTP_USER = your-gmail-address@gmail.com
SMTP_PASS = your-gmail-app-password
MAIL_FROM = SyncChat <your-gmail-address@gmail.com>
FEEDBACK_EMAIL = your-gmail-address@gmail.com

# social auth providers
GOOGLE_CLIENT_ID =
FACEBOOK_APP_ID =
TELEGRAM_BOT_USERNAME =
TELEGRAM_BOT_TOKEN =

# Web Push (VAPID)
VAPID_PUBLIC_KEY =
VAPID_PRIVATE_KEY =
VAPID_SUBJECT = mailto:support@syncchat.app

# Upload limits (hard cap used by multer)
CHAT_UPLOAD_HARD_LIMIT_MB = 250
