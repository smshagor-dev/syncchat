NODE_ENV = development

# MySQL
DB_HOST = 127.0.0.1
DB_PORT = 3306
DB_NAME = syncchat
DB_USER = root
DB_PASSWORD = root
DB_AUTO_MIGRATE = true

# optional public origin for generated local upload URLs
# APP_ORIGIN = http://localhost:8080

# email transport (nodemailer)
# Gmail SMTP
SMTP_SERVICE = gmail
SMTP_HOST = smtp.gmail.com
SMTP_HOST_IP =
SMTP_SERVERNAME = smtp.gmail.com
SMTP_PORT = 465
SMTP_SECURE = true
SMTP_USER = your-gmail-address@gmail.com
SMTP_PASS = your-gmail-app-password
MAIL_FROM = SyncChat <your-gmail-address@gmail.com>
FEEDBACK_EMAIL = your-gmail-address@gmail.com
