NODE_ENV = development
PORT = 5599

# MongoDB
# Local example: mongodb://127.0.0.1:27017/syncchat
# Atlas example: mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/syncchat?retryWrites=true&w=majority
MONGODB_URI = mongodb://127.0.0.1:27017/syncchat
MONGODB_DB_NAME = syncchat
MONGODB_AUTO_INDEX = true
MONGODB_SERVER_SELECTION_TIMEOUT_MS = 10000
MONGODB_DEBUG = false

# Redis is optional locally but strongly recommended for Vercel/multi-instance Socket.IO.
# Examples: redis://default:PASSWORD@HOST:6379 or rediss://default:PASSWORD@HOST:6379
REDIS_URL =

# Backend deploy
JWT_SECRET = replace-with-a-long-random-secret
APP_ORIGIN = http://localhost:3000,http://127.0.0.1:3000
PUBLIC_ORIGIN = http://localhost:3000
API_BASE_URL = http://127.0.0.1:5599/api
SOCKET_URL = http://127.0.0.1:5599
UPLOAD_PUBLIC_ORIGIN = http://127.0.0.1:5599
SERVE_FRONTEND = false

# Vercel production example (backend project Root Directory = backend)
# NODE_ENV = production
# APP_ORIGIN = https://syncchat.live,https://www.syncchat.live
# PUBLIC_ORIGIN = https://syncchat.live
# API_BASE_URL = https://api.syncchat.live/api
# SOCKET_URL = https://api.syncchat.live
# UPLOAD_PUBLIC_ORIGIN = https://api.syncchat.live
# SERVE_FRONTEND = false
# REDIS_URL = rediss://default:PASSWORD@HOST:6379

# Important for Vercel: this repository currently stores chat uploads on the local filesystem.
# Vercel Function filesystems are not durable storage, so production media should be moved to
# Vercel Blob/S3/R2 or another persistent object store before relying on uploads in production.

# Email transport is stored in the database from Admin Settings > App Config.
# Set SMTP host, port, secure, user, password, from name/email, and support email there.

# social auth providers
GOOGLE_CLIENT_ID =
FACEBOOK_APP_ID =
TELEGRAM_BOT_USERNAME =
TELEGRAM_BOT_TOKEN =

# Web Push (VAPID)
VAPID_PUBLIC_KEY =
VAPID_PRIVATE_KEY =
VAPID_SUBJECT = mailto:support@syncchat.app

# Upload limits (hard cap used by multer)
CHAT_UPLOAD_HARD_LIMIT_MB = 250
