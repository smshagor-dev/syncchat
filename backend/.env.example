NODE_ENV = development
PORT = 5599

# MongoDB
MONGODB_URI = mongodb://127.0.0.1:27017/syncchat
MONGODB_DB_NAME = syncchat
MONGODB_AUTO_INDEX = true
MONGODB_SERVER_SELECTION_TIMEOUT_MS = 10000
MONGODB_DEBUG = false

# Redis is strongly recommended for production. It backs Socket.IO fan-out,
# active call state, chat abuse controls and distributed auth/rate limits.
REDIS_URL =
CALL_STATE_TTL_SEC = 86400

# Authentication. Production refuses to start without a JWT_SECRET of at least
# 32 characters. Changing it signs every current user/admin session out.
JWT_SECRET = replace-with-a-long-random-secret-at-least-32-characters
USER_ACCESS_TOKEN_TTL = 7d
ADMIN_ACCESS_TOKEN_TTL = 7d
TWO_FACTOR_TOKEN_TTL = 10m

# Trust reverse-proxy forwarding headers only when the deployment actually runs
# behind your controlled reverse proxy. Vercel is trusted automatically.
TRUST_PROXY = false

# Optional separate key for encrypting FTP credentials at rest. Falls back to JWT_SECRET.
STORAGE_CONFIG_SECRET =
# Optional separate key for SMTP passwords stored through Admin > App Config.
# Falls back to STORAGE_CONFIG_SECRET, then JWT_SECRET. Keep it stable.
SMTP_CONFIG_SECRET =
# Optional separate key for encrypting TURN, LiveKit SFU, FCM and APNs private keys at rest.
CALL_CONFIG_SECRET =
# Optional separate key for DB-backed chat translation/transcription provider secrets.
CHAT_AI_CONFIG_SECRET =
# Optional separate key for DB-backed Google/Facebook/Telegram secrets.
SOCIAL_AUTH_CONFIG_SECRET =

APP_ORIGIN = http://localhost:3000,http://127.0.0.1:3000
PUBLIC_ORIGIN = http://localhost:3000
API_BASE_URL = http://127.0.0.1:5599/api
SOCKET_URL = http://127.0.0.1:5599
SERVE_FRONTEND = false

# Persistent uploads are configured from Admin > FTP Storage.
# Supported: FTP, explicit FTPS, implicit FTPS.

# Calling/WebRTC settings are configured from Admin > Calling & WebRTC.
# Production multi-instance calling requires REDIS_URL for shared active-call state.

# Chat abuse/flood controls. Redis is used when REDIS_URL is configured;
# otherwise a single-process in-memory fallback is used.
CHAT_RATE_LIMIT_MESSAGES = 30
CHAT_RATE_LIMIT_WINDOW_SEC = 10
CHAT_DUPLICATE_LIMIT = 6
CHAT_DUPLICATE_WINDOW_SEC = 30

# SMTP is normally configured from Admin > App Config and its password is
# encrypted at rest. These environment values are also supported as a fallback
# (and are useful when secrets are injected by the hosting platform).
SMTP_HOST =
SMTP_PORT = 587
SMTP_SECURE = false
SMTP_USER =
SMTP_PASS =
SMTP_FROM_NAME = SyncChat
SMTP_FROM_EMAIL =
SMTP_TLS_REJECT_UNAUTHORIZED = true
SMTP_CONNECTION_TIMEOUT_MS = 15000
SMTP_GREETING_TIMEOUT_MS = 15000
SMTP_SOCKET_TIMEOUT_MS = 30000
SMTP_MAX_CONNECTIONS = 3
SMTP_MAX_MESSAGES = 100

# Google, Facebook and Telegram provider IDs/tokens are configured from
# Admin > Social Login and stored encrypted in MongoDB.

# Web/PWA push remains environment-backed.
VAPID_PUBLIC_KEY =
VAPID_PRIVATE_KEY =
VAPID_SUBJECT = mailto:support@syncchat.app

CHAT_UPLOAD_HARD_LIMIT_MB = 250
ACCOUNT_BACKUP_UPLOAD_LIMIT_MB = 100
FTP_DEBUG = false
