NODE_ENV = development
PORT = 5599

# MongoDB
MONGODB_URI = mongodb://127.0.0.1:27017/syncchat
MONGODB_DB_NAME = syncchat
MONGODB_AUTO_INDEX = true
MONGODB_SERVER_SELECTION_TIMEOUT_MS = 10000
MONGODB_DEBUG = false

REDIS_URL =
# Active call state TTL in Redis. Default: 86400 seconds (24 hours).
CALL_STATE_TTL_SEC = 86400

JWT_SECRET = replace-with-a-long-random-secret
# Optional separate key for encrypting FTP credentials at rest. Falls back to JWT_SECRET.
STORAGE_CONFIG_SECRET =
# Optional separate key for encrypting TURN, LiveKit SFU, FCM and APNs private keys at rest.
# Falls back to STORAGE_CONFIG_SECRET, then JWT_SECRET. Keep this value stable.
CALL_CONFIG_SECRET =
# Optional separate key for DB-backed chat translation/transcription provider secrets.
# Falls back to CALL_CONFIG_SECRET, STORAGE_CONFIG_SECRET, then JWT_SECRET. Keep stable.
CHAT_AI_CONFIG_SECRET =
APP_ORIGIN = http://localhost:3000,http://127.0.0.1:3000
PUBLIC_ORIGIN = http://localhost:3000
API_BASE_URL = http://127.0.0.1:5599/api
SOCKET_URL = http://127.0.0.1:5599
SERVE_FRONTEND = false

# Persistent uploads are configured from Admin > FTP Storage.
# Supported: FTP, explicit FTPS, implicit FTPS.
# Configure host, port, security, username, password, remote base path and public base URL in Admin.

# Calling/WebRTC settings are configured from Admin > Calling & WebRTC.
# Configure global audio/video/group calling, STUN/TURN, LiveKit SFU,
# call timing, audio processing and video quality from the DB-backed admin page.
# LiveKit URL/API key/API secret are stored in MongoDB from Admin.
# Android FCM and iOS APNs/PushKit credentials are configured from Admin > Native Call Push.
# FCM/APNs private keys are encrypted in MongoDB using CALL_CONFIG_SECRET.
# Production calling also requires REDIS_URL for shared durable active-call state.

# Chat abuse/flood controls. Redis is used when REDIS_URL is configured;
# otherwise a single-process in-memory fallback is used.
CHAT_RATE_LIMIT_MESSAGES = 30
CHAT_RATE_LIMIT_WINDOW_SEC = 10
CHAT_DUPLICATE_LIMIT = 6
CHAT_DUPLICATE_WINDOW_SEC = 30

# Translation/transcription provider URLs and API keys are configured from the
# DB-backed Admin Chat AI panel. Provider keys are encrypted using the secret chain above.

# Email transport is stored in the database from Admin Settings > App Config.

GOOGLE_CLIENT_ID =
FACEBOOK_APP_ID =
TELEGRAM_BOT_USERNAME =
TELEGRAM_BOT_TOKEN =

# Web/PWA push remains environment-backed.
VAPID_PUBLIC_KEY =
VAPID_PRIVATE_KEY =
VAPID_SUBJECT = mailto:support@syncchat.app

CHAT_UPLOAD_HARD_LIMIT_MB = 250
ACCOUNT_BACKUP_UPLOAD_LIMIT_MB = 100
FTP_DEBUG = false
