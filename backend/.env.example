NODE_ENV = development
PORT = 5599

# MongoDB
MONGODB_URI = mongodb://127.0.0.1:27017/syncchat
MONGODB_DB_NAME = syncchat
MONGODB_AUTO_INDEX = true
MONGODB_SERVER_SELECTION_TIMEOUT_MS = 10000
MONGODB_DEBUG = false

REDIS_URL =

JWT_SECRET = replace-with-a-long-random-secret
# Optional separate key for encrypting FTP credentials at rest. Falls back to JWT_SECRET.
STORAGE_CONFIG_SECRET =
# Optional separate key for encrypting TURN credentials/shared secrets at rest.
# Falls back to STORAGE_CONFIG_SECRET, then JWT_SECRET.
CALL_CONFIG_SECRET =
APP_ORIGIN = http://localhost:3000,http://127.0.0.1:3000
PUBLIC_ORIGIN = http://localhost:3000
API_BASE_URL = http://127.0.0.1:5599/api
SOCKET_URL = http://127.0.0.1:5599
SERVE_FRONTEND = false

# Persistent uploads are configured from Admin > FTP Storage.
# Supported: FTP, explicit FTPS, implicit FTPS.
# Configure host, port, security, username, password, remote base path and public base URL in Admin.

# Calling/WebRTC settings are configured from Admin > Calling & WebRTC.
# Configure global audio/video/group calling, STUN/TURN servers, TURN auth,
# call timing, audio processing and video quality from the DB-backed admin page.

# Email transport is stored in the database from Admin Settings > App Config.

GOOGLE_CLIENT_ID =
FACEBOOK_APP_ID =
TELEGRAM_BOT_USERNAME =
TELEGRAM_BOT_TOKEN =

VAPID_PUBLIC_KEY =
VAPID_PRIVATE_KEY =
VAPID_SUBJECT = mailto:support@syncchat.app

CHAT_UPLOAD_HARD_LIMIT_MB = 250
ACCOUNT_BACKUP_UPLOAD_LIMIT_MB = 100
FTP_DEBUG = false
