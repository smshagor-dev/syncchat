NODE_ENV = development
PORT = 5599

# MySQL
DB_HOST = 127.0.0.1
DB_PORT = 3306
DB_NAME = syncchat
DB_USER = root
DB_PASSWORD = root
DB_AUTO_MIGRATE = true

# Backend deploy
JWT_SECRET = replace-with-a-long-random-secret
APP_ORIGIN = http://localhost:3000,http://127.0.0.1:3000
PUBLIC_ORIGIN = http://localhost:3000
API_BASE_URL = http://127.0.0.1:5599/api
SOCKET_URL = http://127.0.0.1:5599
UPLOAD_PUBLIC_ORIGIN = http://127.0.0.1:5599
SERVE_FRONTEND = false

# Public backend URLs used by CORS and generated links
# API_BASE_URL = https://api.syncchat.live/api
# SOCKET_URL = https://api.syncchat.live
# PUBLIC_ORIGIN = https://syncchat.live

# Email transport is stored in the database from Admin Settings > App Config.
# Set SMTP host, port, secure, user, password, from name/email, and support email there.

# social auth providers
GOOGLE_CLIENT_ID =
FACEBOOK_APP_ID =
TELEGRAM_BOT_USERNAME =
TELEGRAM_BOT_TOKEN =

# Web Push (VAPID)
VAPID_PUBLIC_KEY =
VAPID_PRIVATE_KEY =
VAPID_SUBJECT = mailto:support@syncchat.app

# Upload limits (hard cap used by multer)
CHAT_UPLOAD_HARD_LIMIT_MB = 250
